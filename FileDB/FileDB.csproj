<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>OS_WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  
  <ItemGroup>
    <Content Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Castle.Windsor" Version="6.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.20" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="NReco.Logging.File" Version="1.4.0" />

    <PackageReference Include="System.Speech" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileDBInterface\FileDBInterface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Lang\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Views\HelpView.axaml.cs">
      <DependentUpon>HelpView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\File\FileCategorizationView.axaml.cs">
      <DependentUpon>FileCategorizationView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\PersonProfileFilesView.axaml.cs">
      <DependentUpon>PersonProfileFilesView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\UpdateTagsView.axaml.cs">
      <DependentUpon>UpdateTagsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\UpdateLocationsView.axaml.cs">
      <DependentUpon>UpdateLocationsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\UpdatePersonsView.axaml.cs">
      <DependentUpon>UpdatePersonsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\File\FileHistoryView.axaml.cs">
      <DependentUpon>FileHistoryView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\File\FileMetaDataView.axaml.cs">
      <DependentUpon>FileMetaDataView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\CombineView.axaml.cs">
      <DependentUpon>CombineView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\RandomView.axaml.cs">
      <DependentUpon>RandomView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\DirectoryView.axaml.cs">
      <DependentUpon>DirectoryView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\TagsView.axaml.cs">
      <DependentUpon>TagsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\PersonGroupView.axaml.cs">
      <DependentUpon>PersonGroupView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\TimeView.axaml.cs">
      <DependentUpon>TimeView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\AnnualDateView.axaml.cs">
      <DependentUpon>AnnualDateView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\DateView.axaml.cs">
      <DependentUpon>DateView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\SeasonView.axaml.cs">
      <DependentUpon>SeasonView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Search\Filters\AllFilesView.axaml.cs">
      <DependentUpon>AllFilesView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Lang\Strings.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\licenses.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
