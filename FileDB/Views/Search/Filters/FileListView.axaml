<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileDB.ViewModels.Search.Filters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:lang="clr-namespace:FileDB.Lang"
			 xmlns:converters="clr-namespace:FileDB.Converters"
             mc:Ignorable="d"
             x:DataType="vm:FileListViewModel" x:Class="FileDB.Views.Search.Filters.FileListView">
	<StackPanel Orientation="Horizontal">
		<TextBox Text="{Binding FileListIds}" Width="100" VerticalAlignment="Center" ToolTip.Tip="{x:Static lang:Strings.SearchFilterFileListToolTip}"/>
		<Button Margin="3 0" Content="..." VerticalAlignment="Center">
			<Button.Flyout>
				<MenuFlyout>
					<MenuItem Header="{x:Static lang:Strings.SearchCombineSearchCurrentMenuItem}" Command="{Binding SetFromCurrentCommand}" IsEnabled="{Binding HasSearchResult}"/>
				</MenuFlyout>
			</Button.Flyout>
		</Button>
		<ToggleButton Classes="ColoredToggleButton" Content="!" IsChecked="{Binding Negate}" ToolTip.Tip="{x:Static lang:Strings.FilterNegateTooltip}"/>
	</StackPanel>
</UserControl>
