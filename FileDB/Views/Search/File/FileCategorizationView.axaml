<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:lang="clr-namespace:FileDB.Lang"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileDB.Views.Search.File.FileCategorizationView">
	<Expander IsVisible="{Binding ReadWriteMode}" Header="{Binding Header}" IsExpanded="{Binding IsExpanded}">
		<ScrollViewer>
			<StackPanel Orientation="Vertical">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Button Margin="5,0,0,5" HorizontalAlignment="Left" Command="{Binding AddMetaDataFromPrevEditedFileCommand}" IsEnabled="{Binding CanApplyMetaDataFromPrevEdit}" ToolTip.Tip="{x:Static lang:Strings.CategorizationApplyMetaDataFromLastEditToolTip}" Content="{x:Static lang:Strings.CategorizationApplyMetaDataFromLastEditButton}"/>
					<Button Margin="5,0,0,5" HorizontalAlignment="Left" Command="{Binding MarkPrevEditedFileCommand}" IsEnabled="{Binding CanMarkCurrentFileAsPrevEdited}" ToolTip.Tip="{x:Static lang:Strings.CategorizationMarkButtonToolTip}" Content="{x:Static lang:Strings.CategorizationMarkButton}"/>
				</StackPanel>

				<Grid ColumnDefinitions="auto,*" RowDefinitions="auto,auto,auto">
					<TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="&#8635;" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="{x:Static lang:Strings.CategorizationOrientationToolTip}"/>
					<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" Orientation="Horizontal">
						<Button Content="&#8635;" Margin="0,0,5,0" ToolTip.Tip="{x:Static lang:Strings.CategorizationRotate90DegreesClockwiseToolTip}" Command="{Binding RotateFileClockwiseCommand}" IsEnabled="{Binding FileSelected}"/>
						<Button Content="&#8634;" ToolTip.Tip="{x:Static lang:Strings.CategorizationRotate90DegreesCounterClockwiseToolTip}" Command="{Binding RotateFileCounterClockwiseCommand}" IsEnabled="{Binding FileSelected}"/>
					</StackPanel>

					<TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="&#x1F4C5;" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="{x:Static lang:Strings.CategorizationFileDateAndTimeToolTip}"/>
					<TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" Text="{Binding NewFileDateTime}" IsEnabled="{Binding FileSelected}" ToolTip.Tip="{x:Static lang:Strings.CategorizationDateAndTimeFormatToolTip}" MaxWidth="300"/>

					<TextBlock Grid.Row="2" Grid.Column="0" Text="&#x1F6F0;" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="{x:Static lang:Strings.FileInfoPositionToolTip}"/>
					<TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" Text="{Binding FilePosition}" ToolTip.Tip="{x:Static lang:Strings.CategorizationPositionFormatToolTip}" IsVisible="{Binding FilePosition, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
					<TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" VerticalAlignment="Center" Text="No position available" IsVisible="{Binding FilePosition, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
				</Grid>
				
				<StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Margin="5,0,0,0" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Content="{x:Static lang:Strings.CategorizationSaveButton}"/>
					<Button Margin="5,0,0,0" Command="{Binding ResetCommand}" IsEnabled="{Binding IsDirty}" Content="{x:Static lang:Strings.CategorizationResetButton}"/>
					<Button Margin="5,0,0,0" Command="{Binding ReloadCommand}" IsEnabled="{Binding FileSelected}" ToolTip.Tip="{x:Static lang:Strings.CategorizationReloadFileDateTimeGPSPositionAndOrientationToolTip}" Content="{x:Static lang:Strings.CategorizationReloadButton}"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Expander>
</UserControl>
