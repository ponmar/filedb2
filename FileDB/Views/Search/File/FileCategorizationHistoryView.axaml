<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:lang="clr-namespace:FileDB.Lang"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileDB.Views.Search.File.FileCategorizationHistoryView">
	<Expander IsVisible="{Binding IsExpanded}" Header="{x:Static lang:Strings.CategorizationUpdateHistoryTitle}">
		<ScrollViewer>
			<StackPanel>
				<TextBlock IsVisible="{Binding !UpdateHistoryItems.Count}" Text="{x:Static lang:Strings.CategorizationNoChanges}"/>
				<ItemsControl ItemsSource="{Binding UpdateHistoryItems}" IsVisible="{Binding FileSelected}" x:Name="HistoryItemsItemsControl">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0 3 0 3">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" SharedSizeGroup="column1"/>
									<ColumnDefinition Width="Auto" SharedSizeGroup="column2"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<ToggleButton Grid.Column="0" Classes="ColoredToggleButton" Margin="0 0 3 0" Content="{Binding ToggleText}" IsChecked="{Binding IsChecked, Mode=OneWay}" ToolTip.Tip="{Binding ToolTip}" Command="{Binding ElementName=HistoryItemsItemsControl, Path=DataContext.ToggleFromHistoryItemCommand}" CommandParameter="{Binding}"/>
								<Button Grid.Column="1" Command="{Binding ElementName=HistoryItemsItemsControl, Path=DataContext.RemoveHistoryItemCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Content="&#128473;" ToolTip.Tip="{x:Static lang:Strings.CategorizationRemoveItemFromUpdateHistory}"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Expander>
</UserControl>
