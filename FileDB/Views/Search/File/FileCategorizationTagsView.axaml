<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:lang="clr-namespace:FileDB.Lang"
			 xmlns:vm="clr-namespace:FileDB.ViewModels.Search.File"
             x:Class="FileDB.Views.Search.File.FileCategorizationTagsView"
             IsVisible="{Binding UpdateItemsVisible}">
    <Expander Header="{Binding UpdateTagsHeader}" ToolTip.Tip="{Binding UpdateTagsHeaderToolTip}" IsExpanded="{Binding UpdateTagsIsExpanded}">
		<Grid ColumnDefinitions="auto" RowDefinitions="auto,auto,*">
			<StackPanel Grid.Row="0" Orientation="Horizontal" IsVisible="{Binding FileSelected}">
				<TextBlock Text="&#x1F50D;" VerticalAlignment="Center"/>
				<TextBox Width="125" Text="{Binding TagsFilterText}" Margin="3,0,3,0" VerticalAlignment="Center"  ToolTip.Tip="{x:Static lang:Strings.CategorizationItemSearchToolTip}"/>
				<ToggleButton Classes="ColoredToggleButton" IsChecked="{Binding TagsFilterTextCaseSensitive}" Content="&#x1F5DA;" ToolTip.Tip="{x:Static lang:Strings.TextFilterCaseSensitive}"/>
			</StackPanel>

			<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
				<Button Content="&#9744;" Margin="3,0,0,0" IsEnabled="{Binding HasVisibleTags}" VerticalAlignment="Center" Command="{Binding RemoveTagsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdateTagsRemoveAllToolTip}"/>
				<Button Content="&#9745;" Margin="3,0,0,0" IsEnabled="{Binding HasVisibleTags}" VerticalAlignment="Center" Command="{Binding AddTagsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdateTagsAddAllToolTip}"/>
				<Button Content="&#10133;" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding CreateTagCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationCreateANewTagAndAddItToCurrentFileToolTip}"/>
			</StackPanel>

			<TextBlock Grid.Row="2" IsVisible="{Binding !Tags.Count}" Text="{x:Static lang:Strings.CategorizationUpdateTagsNoTags}"/>
			<ScrollViewer Grid.Row="2" Margin="0,10,0,0">
				<ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding FileSelected}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ToggleTagViewModel">
							<ToggleButton IsVisible="{Binding IsVisible}" Command="{Binding $parent[ItemsControl].DataContext.ToggleTagCommand}" CommandParameter="{Binding}" Classes="ColoredToggleButton" Margin="0,2,0,2" Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneWay}" ToolTip.Tip="{Binding ToolTip}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Expander>
</UserControl>
