<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:lang="clr-namespace:FileDB.Lang"
			 xmlns:vm="clr-namespace:FileDB.ViewModels.Search.File"
             x:Class="FileDB.Views.Search.File.FileCategorizationPersonsView"
             IsVisible="{Binding UpdateItemsVisible}">
    <Expander Header="{Binding UpdatePersonsHeader}" IsExpanded="{Binding UpdatePersonsIsExpanded}">
		<Grid ColumnDefinitions="auto" RowDefinitions="auto,*">
			<StackPanel Grid.Row="0" Orientation="Horizontal" IsVisible="{Binding FileSelected}">
				<TextBlock Text="&#x1F50D;" VerticalAlignment="Center"/>
				<TextBox Width="125" Text="{Binding PersonsFilterText}" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdatePersonsSearchToolTip}"/>
				<Button Content="&#9744;" Margin="3,0,0,0" IsEnabled="{Binding HasVisiblePersons}" VerticalAlignment="Center" Command="{Binding RemovePersonsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdatePersonsRemoveAllToolTip}"/>
				<Button Content="&#9745;" Margin="3,0,0,0" IsEnabled="{Binding HasVisiblePersons}" VerticalAlignment="Center" Command="{Binding AddPersonsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdatePersonsAddAllToolTip}"/>
				<Button Content="&#10133;" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding CreatePersonCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationCreateANewPersonAndAddItToCurrentFileToolTip}"/>
			</StackPanel>

            <TextBlock Grid.Row="1" IsVisible="{Binding !Persons.Count}" Text="{x:Static lang:Strings.CategorizationUpdatePersonsNoPersons}"/>
			<ScrollViewer Grid.Row="1" Margin="0,10,0,0">
				<ItemsControl ItemsSource="{Binding Persons}" IsVisible="{Binding FileSelected}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:TogglePersonViewModel">
							<ToggleButton IsVisible="{Binding IsVisible}" Command="{Binding $parent[ItemsControl].DataContext.TogglePersonCommand}" CommandParameter="{Binding}" Classes="ColoredToggleButton" Margin="0,2,0,2" Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneWay}" ToolTip.Tip="{Binding ToolTip}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Expander>
</UserControl>
