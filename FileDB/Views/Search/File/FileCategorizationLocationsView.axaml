<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:lang="clr-namespace:FileDB.Lang"
			 xmlns:vm="clr-namespace:FileDB.ViewModels.Search.File"
             x:Class="FileDB.Views.Search.File.FileCategorizationLocationsView"
             IsVisible="{Binding UpdateItemsVisible}">
    <Expander Header="{Binding UpdateLocationsHeader}" IsExpanded="{Binding UpdateLocationsIsExpanded}">
		<Grid ColumnDefinitions="auto" RowDefinitions="auto,*">
			<StackPanel Grid.Row="0" Orientation="Horizontal" IsVisible="{Binding FileSelected}">
				<TextBlock Text="&#x1F50D;" VerticalAlignment="Center"/>
				<TextBox Width="125" Text="{Binding LocationsFilterText}" Margin="5,0,0,0" VerticalAlignment="Center"/>
				<Button Content="&#9744;" Margin="3,0,0,0" IsEnabled="{Binding HasVisibleLocations}" VerticalAlignment="Center" Command="{Binding RemoveLocationsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdateLocationsRemoveAllToolTip}"/>
				<Button Content="&#9745;" Margin="3,0,0,0" IsEnabled="{Binding HasVisibleLocations}" VerticalAlignment="Center" Command="{Binding AddLocationsCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationUpdateLocationsAddAllToolTip}"/>
				<Button Content="&#10133;" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding CreateLocationCommand}" ToolTip.Tip="{x:Static lang:Strings.CategorizationCreateANewLocationAndAddItToCurrentFileToolTip}"/>
			</StackPanel>

			<TextBlock Grid.Row="1" IsVisible="{Binding !Locations.Count}" Text="{x:Static lang:Strings.CategorizationUpdateLocationsNoLocations}"/>
			<ScrollViewer Grid.Row="1" Margin="0,10,0,0">
				<ItemsControl ItemsSource="{Binding Locations}" IsVisible="{Binding FileSelected}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ToggleLocationViewModel">
							<ToggleButton IsVisible="{Binding IsVisible}" Command="{Binding $parent[ItemsControl].DataContext.ToggleLocationCommand}" CommandParameter="{Binding}" Classes="ColoredToggleButton" Margin="0,2,0,2" Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=OneWay}" ToolTip.Tip="{Binding ToolTip}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Expander>
</UserControl>
